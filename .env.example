# Facebook Transport Configuration
# Select the Facebook integration transport:
#   graph_api   - Official Meta Graph API (dormant during development)
#   camoufox_ui - Camoufox browser UI transport (active experimental transport)
FACEBOOK_TRANSPORT=camoufox_ui

# Camoufox browser profile directory (persistent authenticated session)
# All browser session/auth data lives here and MUST remain gitignored.
# First launch opens headed; log in manually if Facebook requires it.
CAMOUFOX_PROFILE_DIR=data/browser-profile

# Facebook API Configuration (used when FACEBOOK_TRANSPORT=graph_api)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0

# Agent Modes
# Set to 'dry_run' for Phase 0 (proposals only, no Facebook writes)
# Set to 'live' for Phase 1+ (approved actions execute)
UNATTENDED_BOT_MODE=dry_run

# Rate Limits (actions per time window)
# Hourly limit for POST actions
RATE_LIMIT_POSTS_HOURLY=5
# Daily limit for REPLY actions
RATE_LIMIT_REPLIES_DAILY=50
# Minimum seconds between actions
MIN_ACTION_INTERVAL_SECONDS=1800

# Approval Mode
# If 'true', actions must be approved before execution
APPROVAL_MODE=true

# SQLite Database Path (relative to project root or absolute)
DATABASE_PATH=data/bot.db

# Session home for Hermes profile (set externally when running)
# HERMES_HOME=